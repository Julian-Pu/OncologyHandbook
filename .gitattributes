# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Kotlin and Java sources
*.kt text eol=lf
*.java text eol=lf

# XML resources
*.xml text eol=lf

# Gradle files
*.gradle text eol=lf
*.gradle.kts text eol=lf
*.properties text eol=lf
*.toml text eol=lf

# Documents
*.md text eol=lf
*.txt text eol=lf

# Binary files
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.so binary
*.jar binary
*.apk binary
*.aab binary
*.zip binary
