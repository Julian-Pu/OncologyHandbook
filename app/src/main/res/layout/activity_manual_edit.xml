<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
        app:menu="@menu/menu_manual_edit" />

    <!-- 格式化工具栏 -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#f5f5f5"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="4dp"
            android:paddingHorizontal="8dp"
            android:descendantFocusability="blocksDescendants">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_bold"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:text="B"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="@color/text_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_italic"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:text="I"
                android:textSize="16sp"
                android:textStyle="italic"
                android:textAllCaps="false"
                android:textColor="@color/text_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_underline"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:text="U"
                android:textSize="16sp"
                android:paddingTop="2dp"
                android:textAllCaps="false"
                android:textColor="@color/text_primary" />

            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:layout_gravity="center_vertical"
                android:layout_marginHorizontal="4dp"
                android:background="#e0e0e0" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="颜色:"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginEnd="2dp" />

            <ImageButton
                android:id="@+id/btn_color_red"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center_vertical"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/bg_color_swatch"
                android:backgroundTint="#c62828"
                android:contentDescription="红色" />

            <ImageButton
                android:id="@+id/btn_color_blue"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center_vertical"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/bg_color_swatch"
                android:backgroundTint="#1565c0"
                android:contentDescription="蓝色" />

            <ImageButton
                android:id="@+id/btn_color_green"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center_vertical"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/bg_color_swatch"
                android:backgroundTint="#2e7d32"
                android:contentDescription="绿色" />

            <ImageButton
                android:id="@+id/btn_color_black"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center_vertical"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/bg_color_swatch"
                android:backgroundTint="#212121"
                android:contentDescription="黑色" />

            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:layout_gravity="center_vertical"
                android:layout_marginHorizontal="4dp"
                android:background="#e0e0e0" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_heading"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:text="标题"
                android:textSize="14sp"
                android:textAllCaps="false"
                android:textColor="@color/text_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_clear_format"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:text="清除格式"
                android:textSize="14sp"
                android:textAllCaps="false"
                android:textColor="@color/text_secondary" />

        </LinearLayout>
    </HorizontalScrollView>

    <WebView
        android:id="@+id/web_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
